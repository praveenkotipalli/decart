# ── Decart (server-side only; never exposed to the browser) ─────────────────
# Create a key at https://platform.decart.ai (new accounts get free credits).
# Leave empty to run the portal with the clearly-labelled local preview only.
DECART_API_KEY=

# Realtime model the portal asks for by default.
#   lucy-2.6        character swap / video editing, 1280x720, $0.02/s  (default)
#   lucy-restyle-2  whole-scene style transfer,     1280x704, $0.01/s
DECART_MODEL=lucy-2.6

# Models the browser may request. Each minted token is scoped to one of these.
DECART_ALLOWED_MODELS=lucy-2.6,lucy-restyle-2

# Lifetime of each client token, in seconds (1-3600). Tokens only gate new
# connections; the SDK fetches a fresh one for every connect and reconnect.
DECART_TOKEN_TTL_SECONDS=60

# Hard cap on a single realtime session, in seconds (min 10). Bounds the cost
# of a forgotten tab: lucy-2.6 is billed per second of generation.
DECART_MAX_SESSION_SECONDS=600

# Allow the UI to request fast mode (lower latency, billed at 2x).
DECART_ALLOW_FAST=false

# API base URL. Only change this if Decart tells you to.
DECART_BASE_URL=https://api.decart.ai

# ── Local server ─────────────────────────────────────────────────────────────
PORT=8787
# Vite dev server port (http://localhost:5199).
WEB_PORT=5199

# Web origins allowed to mint tokens, comma separated. Localhost origins on any
# port are always allowed. Add your deployed origin here if you host the app.
ALLOWED_ORIGINS=

# Max token requests per IP per minute.
TOKEN_RATE_LIMIT_PER_MINUTE=20
